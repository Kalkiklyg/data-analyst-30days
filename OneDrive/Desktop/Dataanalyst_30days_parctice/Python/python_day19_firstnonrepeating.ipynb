   "source": [
    "# day19_first_non_repeating.py\n",
    "def first_non_repeating(s):\n",
    "    counts = {}\n",
    "    for ch in s:\n",
    "        counts[ch] = counts.get(ch, 0) + 1\n",
    "    for ch in s:\n",
    "        if counts[ch] == 1:\n",
    "            return ch\n",
    "    return None\n",
    "\n",
    "print(first_non_repeating(\"swiss\"))  # -> 'w'\n"
   ]
