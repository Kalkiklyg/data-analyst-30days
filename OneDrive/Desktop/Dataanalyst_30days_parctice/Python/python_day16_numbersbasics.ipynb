    "# day15_numbers_casting.py\n",
    "a = int(\"42\")\n",
    "b = float(\"3.14\")\n",
    "print(\"a:\", a, \"b:\", b)\n",
    "print(\"pow(2,10):\", pow(2,10))\n",
    "print(\"divmod(25,4):\", divmod(25,4))\n",
    "print(\"int(4.9) ->\", int(4.9), \"round(4.9) ->\", round(4.9))\n"
   ]
