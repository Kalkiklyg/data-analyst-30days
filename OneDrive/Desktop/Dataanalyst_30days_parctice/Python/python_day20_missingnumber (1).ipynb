    "# day20_missing_number.py\n",
    "def find_missing(arr, n):\n",
    "    total_expected = n*(n+1)//2\n",
    "    return total_expected - sum(arr)\n",
    "\n",
    "print(find_missing([1,2,4,5], 5))  # -> 3\n"
   ]
