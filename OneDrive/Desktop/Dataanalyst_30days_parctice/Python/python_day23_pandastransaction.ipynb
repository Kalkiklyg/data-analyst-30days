    "# day23_pandas_transactions.py\n",
    "import pandas as pd\n",
    "tx = pd.read_csv(\"data/transactions.csv\")\n",
    "totals = tx.groupby(\"cust_id\")[\"amount\"].sum().sort_values(ascending=False)\n",
    "print(\"Totals per customer:\\n\", totals)\n",
    "print(\"Top 3 spenders:\\n\", totals.head(3))\n"
   ]
  }
