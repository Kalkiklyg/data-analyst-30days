   "source": [
    "# day10_string_methods.py\n",
    "text = \"data science is fun. data drives decisions.\"\n",
    "print(text.upper())\n",
    "print(text.title())\n",
    "print(text.replace(\"data\", \"info\"))\n",
    "print(\"count of 'data':\", text.count(\"data\"))\n",
    "print(\"first 'drives' at:\", text.find(\"drives\"))\n"
   ]
