   "source": [
    "# day09_strings_basic.py\n",
    "s = \"   HeLLo, Krishna! Welcome to Python.   \"\n",
    "clean = s.strip().lower()\n",
    "words = clean.split()\n",
    "joined = \" \".join(words)\n",
    "print(\"clean:\", clean)\n",
    "print(\"words:\", words)\n",
    "print(\"joined:\", joined)\n"
   ]
