    "# day18_regex_cleaning.py\n",
    "import re\n",
    "\n",
    "def clean_text(s):\n",
    "    s = s.strip()\n",
    "    s = re.sub(r'[^\\w\\s]', '', s)   # remove punctuation\n",
    "    s = re.sub(r'\\s+', ' ', s)      # normalize spaces\n",
    "    return s.lower()\n",
    "\n",
    "print(clean_text(\"  I need a REFUND!  \"))\n"
   ]
