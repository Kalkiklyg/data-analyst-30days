    "# day21_reverse_methods.py\n",
    "s = \"example\"\n",
    "rev1 = s[::-1]\n",
    "rev2 = \"\".join(reversed(s))\n",
    "rev3 = \"\".join([s[i] for i in range(len(s)-1, -1, -1)])\n",
    "print(rev1, rev2, rev3)\n"
   ]
